<https://starwars.com#planet_Shihon>
        rdf:type              ies:Planet ;
        rdfs:comment          "Shihon was a planet of the Chiss Ascendancy. Home to a number of bird species, Shihon was host to the Grand Migration, a yearly event that saw the confluence of a number of different birds' migratory patterns. Haplif of the Agbui, while traveling with the Chiss Yoponek and Yomie in an attempt to study the Ascendancy prior to orchestrating its fall by sparking a civil war, was forced to remain on Shihon so that Yomie could view the Grand Migration. " ;
        ies:hasName           <https://starwars.com#94ad644b-153f-4d3a-a515-ef0fc96afda3> ;
        ies:inLocation        <https://starwars.com#sector_ChissAscendancy> , <https://starwars.com#grid_E8> ;
        graphql:primaryName  "Shihon" .


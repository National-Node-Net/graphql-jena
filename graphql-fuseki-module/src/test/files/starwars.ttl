        rdf:type              ies:Planet ;
        rdfs:comment          "Knolstee was a near-virgin planet in the Corporate Sector owned by Park Holdings Inc.. Park Holdings used the planet as a layover for traveling tourists. Sightseers were welcome to stay in small luxurious orbital stations then descend to Knolstee's surface where they could take tours lead by Park Holdings mostly Ithorian staff. " ;
        ies:hasName           <https://starwars.com#34adb7c3-de5f-4476-9ab5-ea53e23b70a0> ;
        ies:inLocation        <https://starwars.com#grid_R3> , <https://starwars.com#sector_CorporateSector> ;

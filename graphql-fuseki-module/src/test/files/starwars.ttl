<https://starwars.com#40413b42-5dbc-4ecb-9ad8-7a33c7d96955>
        rdf:type                 ies:PlaceName ;
        ies:representationValue  "Hyabb" .

<https://starwars.com#planet_Hyabb>
        rdf:type              ies:Planet ;
        rdfs:comment          "Decades before 4050 BBY, both Hyabb and Twith came under the oppression of the Nelori Marauders, a group of bandits that established their base in the Hyabb-Twith Corridor. Due to the hyperlane serving as a no-man's-land zone for the two rival worlds, the Marauders preyed unopposed on both Hyabb and Twith and surrounding star systems. The Republic's Jedi Order eventually defeated the Nelori, freeing both Hyabb and Twith from the outlaws' influence. " ;
        ies:hasName           <https://starwars.com#40413b42-5dbc-4ecb-9ad8-7a33c7d96955> ;
        ies:inLocation        <https://starwars.com#grid_K9> , <https://starwars.com#region_Core> ;

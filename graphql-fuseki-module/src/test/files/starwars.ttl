<https://starwars.com#planet_Krann>
        rdf:type              ies:Planet ;
        rdfs:comment          "Krann was a planet in the Expansion Region, on the Harrin Trade Corridor. It was taken over by the Galactic Empire for its nova crystals, and the native Kluuzot were enslaved. Following the Battle of Endor, the sector governor seceded and established a neutral terrority. The Kluuzot were freed, and various commercial investors moved to the planet. " ;
        ies:hasName           <https://starwars.com#e243fb2c-3ad4-45b1-bd25-bdb06249cf58> ;
        ies:inLocation        <https://starwars.com#grid_O15> , <https://starwars.com#sector_Brevost> ;
        graphql:primaryName  "Krann" .

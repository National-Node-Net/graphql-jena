        rdf:type                 ies:PlaceName ;
        ies:representationValue  "Zirulast" .

<https://starwars.com#planet_Zirulast>
        rdf:type              ies:Planet ;
        rdfs:comment          "Zirulast was a terrestrial backwater planet located in the Zirulast system, a part of the Belasco sector in the Slice portion of the Expansion Region. Orbiting the white dwarf star of the same name, Zirulast was situated on the Ootmian Pabol hyperlane, which connected it to the Belasco system as well as the New Apsolon system in the Mid Rim. Zirulast was a dry and dusty world encircled by rings of ice particles. The Temolaks, sentient humanoids speaking the Temolish language, were native to the planet, evolving redundant internal organs in order to survive the rigors of their homeworld. " ;
        ies:hasName           <https://starwars.com#0d2f92a1-55ff-48d6-9682-61b2680dbd00> ;
        ies:inLocation        <https://starwars.com#sector_Belasco> , <https://starwars.com#grid_P11> ;
        graphql:primaryName  "Zirulast" .


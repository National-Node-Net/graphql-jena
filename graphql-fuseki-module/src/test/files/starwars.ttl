<https://starwars.com#planet_Humbarine>
        rdf:type              ies:Planet ;
        rdfs:comment          "Humbarine was an ancient, conservative planet located in the galaxy's Core Worlds. Galen Walton Erso attended the Humbarine Academy of Advanced Studies after an internship at the Galactic Republic's Ministry of Energy. During the Imperial Era, Humbarine supported the Galactic Emperor Sheev Palpatine. After the signing of the Galactic Concordance, which conditionally allowed the remnants of the Empire to peacefully co-exist with the New Republic, Humbarine came under control of the Inner systems' Imperial remnant. Lega Fossang was a member of Humbarine's planetary defense force prior to her recruitment to the Resistance. " ;
        ies:hasName           <https://starwars.com#13038f11-b828-4dc7-b4a0-0059580b07b9> ;
        ies:inLocation        <https://starwars.com#grid_M10> , <https://starwars.com#region_Core> ;
        graphql:primaryName  "Humbarine" .

<https://starwars.com#13038f11-b828-4dc7-b4a0-0059580b07b9>
        rdf:type                 ies:PlaceName ;

<https://starwars.com#78699f6e-5378-4dc3-8b52-a9dce295cee9>
        rdf:type                 ies:PlaceName ;
        ies:representationValue  "Gholondreine" .

<https://starwars.com#planet_Gholondreine>
        rdf:type              ies:Planet ;
        rdfs:comment          "The Gholondreine were the natives of the planet Gholondreine-β. The scholars and philosophers of the Gholondreine were renowned across the galaxy, and held that all beings owed their highest loyalty to truth, regardless of temporal consequences. Consequently, they were reluctant to implement the changes of the New Order, and around 10 BBY, began circulating critiques of the Galactic Empire's rule. As punishment, Palpatine had all the water stripped from their homeworld and taken to Coruscant. The dying desert world was subsequently abandoned as they moved to nearby systems. " ;
        ies:hasName           <https://starwars.com#78699f6e-5378-4dc3-8b52-a9dce295cee9> ;
        ies:inLocation        <https://starwars.com#sector_Chitarghar> , <https://starwars.com#grid_K15> ;
        graphql:primaryName  "Gholondreine" .


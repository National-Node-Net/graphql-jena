        ies:representationValue  "Ralltiir" .

<https://starwars.com#planet_Ralltiir>
        rdf:type              ies:Planet ;
        rdfs:comment          "Ralltiir was a terrestrial planet located in the Core Worlds region. During the Clone Wars, Lieutenant Commander Orson Krennic of the Galactic Republic financed a few weeks of vacation on the planet for the smuggler Has Obitt's former crew, as compensation for replacing them. Ralltiir later served as a Rebel Alliance safe world during the Galactic Civil War. The planet was also the homeworld of General Pharl McQuarrie and the pilot Derek Klivian, who were members of the Alliance. " ;
        ies:hasName           <https://starwars.com#b9af3d83-bdb8-46e9-8644-6cbd2f6ffeba> ;
        ies:inLocation        <https://starwars.com#grid_L9> , <https://starwars.com#region_Core> ;
        graphql:primaryName  "Ralltiir" .

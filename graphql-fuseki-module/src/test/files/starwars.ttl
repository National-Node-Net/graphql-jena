<https://starwars.com#55df9464-d348-4e75-8794-ded8bf650828>
        rdf:type                 ies:PlaceName ;
        ies:representationValue  "Vergesso" .

<https://starwars.com#planet_Vergesso>
        rdf:type              ies:Planet ;
        rdfs:comment          "Vergesso was an asteroid in the galaxy's Outer Rim Territories. The former pirate Queen Maz Kanata marked it as a shadowport on a map that she included in the book that became known as the Smuggler's Guide. During the early rebellion against the Galactic Empire, after being rejected for help by the Grand Hutt Council and the Bounty Hunters' Guild in fighting the Galactic Empire, the Alliance to Restore the Republic considered a possible alliance with the Mining Guild, and at the time, the Rebel Alliance maintained an investigation of Mining Guild operations on Vergesso. " ;
        ies:hasName           <https://starwars.com#55df9464-d348-4e75-8794-ded8bf650828> ;
        ies:inLocation        <https://starwars.com#grid_P18> , <https://starwars.com#sector_Bajic> ;
        graphql:primaryName  "Vergesso" .


<https://starwars.com#planet_Elgit>
        rdf:type              ies:Planet ;
        rdfs:comment          "Elgit was a minor trade world that was located within the Elgit system of the galaxy's Hutt Space region and lay on the hyperlane called The Dead Road, which connected it to the planets of Zisia and Usk. The Elgit–M'Hanna Corridor linked Elgit to the world of Sakifwanna, and the trade planet was also joined by a hyperspace route to the Gos Hutta system. " ;
        ies:hasName           <https://starwars.com#39ca3c71-65af-4f63-95bd-d7d5d91a1ea4> ;
        ies:inLocation        <https://starwars.com#grid_T10> , <https://starwars.com#sector_HuttSpace> ;
        graphql:primaryName  "Elgit" .

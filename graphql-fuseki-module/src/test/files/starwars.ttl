<https://starwars.com#planet_Zaddja>
        rdf:type              ies:Planet ;
        rdfs:comment          "Zaddja was a terrestrial astronomical object located in the Zaddja system of the Outer Rim Territories, situated at the coordinates H-15 on the Standard Galactic Grid. Its surface consisted of oceans broken up by archipelagoes of white sand beaches. At night, the beaches were covered by water from the high tides; as such, the inhabitants of Zaddja lived on flying skiffs. A hyperspace route connected Zaddja to Gannaria, a planet in the Trilon sector. " ;
        ies:hasName           <https://starwars.com#03fc7d4a-452f-469a-a896-3c0fb80ff52b> ;
        ies:inLocation        <https://starwars.com#sector_Trilon> , <https://starwars.com#grid_H15> ;
        graphql:primaryName  "Zaddja" .

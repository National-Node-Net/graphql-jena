@prefix graphql: <http://ndtp.co.uk/ontology/> .

<https://starwars.com#55a09a86-2e7f-4533-8705-a5eced730d94>
        rdf:type                 ies:PlaceName ;
        ies:representationValue  "Rhen Var" .

<https://starwars.com#planet_RhenVar>
        rdf:type              ies:Planet ;
        rdfs:comment          "Rhen Var was a planet with frigid environments located near the Galidraan system in the galaxy's Outer Rim Territories. During the galaxy-spanning conflict known as the Clone Wars, the Galactic Republic deployed clone cold assault troopers on the world; troops specifically equipped to deal with cold environments. During the reign of the Galactic Empire, an Imperial outpost was located on Rhen Var. After the stolen Imperial corvette Carrion Spike attacked Imperial facilities in the Galidraan star system, the planet's outpost was considered as one of the potential targets for the corvette by Moff Wilhuff Tarkin. Due to the relative unimportance of the outpost on Rhen Var, Tarkin decided that the Imperial assets on the planet Nam Chorios were a more likely choice for the rebel cell piloting the stolen starship. " ;
        ies:hasName           <https://starwars.com#55a09a86-2e7f-4533-8705-a5eced730d94> ;
        ies:inLocation        <https://starwars.com#grid_R6> , <https://starwars.com#sector_Belderone> ;
        graphql:primaryName  "Rhen Var" .


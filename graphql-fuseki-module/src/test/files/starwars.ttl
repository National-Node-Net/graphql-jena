<https://starwars.com#EchoBase>
        rdf:type              ies:Facility ;
        rdfs:comment          "Echo Base was the facility established by the Rebel Alliance on the frigid planet of Hoth in the wake of the Battle of Yavin, so named due to its strange acoustics. Within a month of its establishment, the base was discovered by the Galactic Empire, which quickly invaded Hoth, forcing the Rebels to evacuate." ;
        ies:hasName           <https://starwars.com#c3ac3a89-31af-46c4-b463-22f39aa63122> ;
        ies:inLocation        <https://starwars.com#planet_Hoth> ;
        graphql:primaryName  "Echo Base" .

<https://starwars.com#c3ac3a89-31af-46c4-b463-22f39aa63122>
        rdf:type                 ies:Name ;
        ies:representationValue  "Echo Base" .


<https://starwars.com#planet_Affa>
        rdf:type              ies:Planet ;
        rdfs:comment          "Affa was a terrestrial planet that housed great droid factories. Arakyd Industries's RA-7 protocol droids, including DK-RA-43, were manufactured in the factories, while parts for Cybot Galactica's 3PO-series protocol droid were also manufactured on the planet. " ;
        ies:hasName           <https://starwars.com#f6cd7a10-20df-4424-8865-905dbb621780> ;
        ies:inLocation        <https://starwars.com#grid_M13> , <https://starwars.com#region_InnerRim> ;

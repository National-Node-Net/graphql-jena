<https://starwars.com#planet_Atzerri>
        rdf:type              ies:Planet ;
        rdfs:comment          "Atzerri was a Gotal colony world in the galaxy's Inner Rim, located in grid square M-13 on the Standard Galactic Grid. In the year 22 BBY, tens of millions of Gotal refugees fled to Atzerri when their homeworld of Antar 4 fell to the Confederacy of Independent Systems shortly after the First Battle of Geonosis, the first battle of the Clone Wars. " ;
        ies:hasName           <https://starwars.com#1c30cb53-103c-4ecf-8d75-3b1241b48873> ;
        ies:inLocation        <https://starwars.com#region_InnerRim> , <https://starwars.com#grid_M13> ;
        graphql:primaryName  "Atzerri" .

<https://starwars.com#planet_Shiffrin>
        rdf:type              ies:Planet ;
        rdfs:comment          "Shiffrin was an Outer Rim Territories planet located in the Tammuz sector. Constable Kallin Bremen maintained law and order in a small village there. At one point, a Shiffrin farmer discovered what turned out to be large deposits of the valuable ore hfredium, and the Galactic Empire subsequently established a garrison there and began confiscating the properties of local landowners. Bremen was eventually executed after planning a peaceful demonstration against the confiscations, and his son, Jak Bremen, went on to leave the planet. " ;
        ies:hasName           <https://starwars.com#ed2e4b5d-da90-4cb8-960b-d8eb53f97f2f> ;
        ies:inLocation        <https://starwars.com#sector_Tammuz> , <https://starwars.com#grid_T15> ;
        graphql:primaryName  "Shiffrin" .


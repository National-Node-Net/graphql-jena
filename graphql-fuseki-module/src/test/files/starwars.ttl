<https://starwars.com#9a3f6e89-d57b-4ad5-9986-d7d8a13dec5c>
        rdf:type                 ies:PlaceName ;
        ies:representationValue  "Near Indosa" .

<https://starwars.com#planet_NearIndosa>
        rdf:type              ies:Planet ;
        rdfs:comment          "Near Indosa was a mining planet that was situated in the north-eastern quadrant of the galaxy and located within the Near Indosa system on the Junction-Tierell Loop hyperlane. The hyperlane was situated in the Gordian Reach sector of the Outer Rim Territories. Near Indosa had been heavily excavated by miners for millennia, which was the reason why most of the planet's mineral resources almost completely disappeared. It was also the reason that many of the miners went to the Far Indosa system during the last days of the Galactic Republic. " ;
        ies:hasName           <https://starwars.com#9a3f6e89-d57b-4ad5-9986-d7d8a13dec5c> ;
        ies:inLocation        <https://starwars.com#grid_P6> , <https://starwars.com#sector_GordianReach> ;
        graphql:primaryName  "Near Indosa" .


@prefix graphql: <http://ndtp.co.uk/ontology/> .

<https://starwars.com#planet_Gigor>
        rdf:type              ies:Planet ;
        rdfs:comment          "Gigor was a frigid planet located in the Tynquay sector of the galaxy's Outer Rim Territories that was the homeworld of the Gigoran species. During the age of the Galactic Empire, many Gigorans on their homeworld were rounded up by Zygerrian slavers and forced in labor. Among these individuals was Senna, a Gigoran who was forced to work as a slave in the spice mines of Kessel. " ;
        ies:hasName           <https://starwars.com#ab0ee0ff-d2a2-45a7-a905-293776a44589> ;
        ies:inLocation        <https://starwars.com#grid_R4> , <https://starwars.com#sector_Tynquay> ;
